#owner: oceanbase
#owner group: shenzhen

connection default;
set names utf8mb4;

# JSON arguments retain their types, including nested prompt objects.
select json_type(json_extract(ai_prompt('{0}', json_object('nested',json_array(1,true,null))), '$.args[0]')) as argument_type;
select json_extract(ai_prompt('{0}', json_array(1,true,null)), '$.args[0]') = json_array(1,true,null) as array_preserved;
select json_type(json_extract(ai_prompt('{0}', cast('true' as json)), '$.args[0]')) as argument_type;
select json_type(json_extract(ai_prompt('{0}', cast('null' as json)), '$.args[0]')) as argument_type;
select json_type(json_extract(ai_prompt('{0}', '{"key":1}'), '$.args[0]')) as argument_type;
select json_type(json_extract(ai_prompt('{0}', ai_prompt('inner {0}', json_array('hello',1))), '$.args[0]')) as argument_type;
select json_unquote(json_extract(ai_prompt('{0}', ai_prompt('inner {0}', 'hello')), '$.args[0].template')) as inner_template;

# Constructing a prompt preserves its template; rendering belongs to AI_COMPLETE.
select json_unquote(json_extract(ai_prompt('{0}/{0}/{9}', 'x'), '$.template')) as template_preserved;
select hex(json_unquote(json_extract(ai_prompt('{0}', json_object('text','你好\n"\\')), '$.args[0].text'))) as escaped_text;
select hex(json_unquote(json_extract(ai_prompt('你好\0', '\0'), '$.template'))) as template_bytes;
select hex(json_unquote(json_extract(ai_prompt('你好\0', '\0'), '$.args[0]'))) as argument_bytes;

# LOB templates and arguments are read without VARCHAR narrowing or locator bytes.
--disable_warnings
drop table if exists ai_prompt_lob_types;
--enable_warnings
create table ai_prompt_lob_types(id int primary key, t longtext, a text, b longtext, j json);
insert into ai_prompt_lob_types values(1, concat(repeat('x',70000),'{0}'), '世界', repeat('y',80000), '{"nested":[1,true,null]}');
select length(json_unquote(json_extract(ai_prompt(t,a,b,j), '$.template'))) as template_length, length(json_unquote(json_extract(ai_prompt(t,a,b,j), '$.args[1]'))) as argument_length from ai_prompt_lob_types where id=1;
select json_unquote(json_extract(ai_prompt(a,b), '$.template')) as text_template, json_type(json_extract(ai_prompt(t,a,b,j), '$.args[2]')) as json_argument_type from ai_prompt_lob_types where id=1;
insert into ai_prompt_lob_types(id) values(2);
--error 1210
select ai_prompt(t) from ai_prompt_lob_types where id=2;
--error 5083
select ai_prompt('template',a) from ai_prompt_lob_types where id=2;
drop table ai_prompt_lob_types;

--error 5083
select ai_prompt(1);
--error 5083
select ai_prompt('{0}',1);
--error 1210
select ai_prompt('');
